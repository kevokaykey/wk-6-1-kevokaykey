{
  "name": "bookstore-demo",
  "version": "1.0.0",
  "description": "A simple book selling app with Paystack integration",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:manual": "echo 'Run manual tests from docs/testing/Manual_Test_Scripts.md'",
    "test:auto": "react-scripts test",
    "test:early": "react-scripts test src/__tests__/early-validation.test.js",
    "test:core": "react-scripts test src/__tests__/core-functionality.test.js",
    "test:smoke": "npm run test:early && npm run test:core",
    "test:e2e:manual": "cypress run --spec cypress/e2e/manual-test-scenarios.cy.js",
    "test:e2e:smoke": "cypress run --spec cypress/e2e/early-stage.cy.js",
    "test:quick": "npm run test:smoke && npm run test:e2e:smoke",
    "test:e2e": "cypress run",
    "test:all": "npm run test:auto && npm run test:e2e",
    "test:coverage": "npm run test:auto -- --coverage --watchAll=false",
    "cy:open": "cypress open",
    "eject": "react-scripts eject",
    "test:e2e:robust": "cypress run --spec cypress/e2e/robust-manual-scenarios.cy.js",
    "docs:testing": "echo '📚 Test Documentation' && ls docs/testing/",
    "docs:test:auto": "echo 'Opening Automated Testing Guide' && open docs/testing/automated-testing-guide.md",
    "docs:test:manual": "echo 'Opening Manual Test Scripts' && open docs/testing/manual-test-scripts.md",
    "docs:test:quick": "echo 'Opening Quick Reference' && open docs/testing/quick-reference.md",
    "docs:test:all": "npm run docs:testing",
    "test:e2e:all": "npm run test:e2e:smoke && npm run test:e2e:robust",
    "test:coverage:html": "npm run test:coverage && open coverage/lcov-report/index.html",
    "test:ci": "npm run test:coverage && npm run test:e2e:manual"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.22.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^13.17.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "wait-on": "^9.0.1",
    "jest-junit": "^13.0.0",
    "mochawesome": "^9.1.3",
    "mochawesome-merge": "^4.2.0",
    "mochawesome-report-generator": "^5.1.0",
    "mocha-junit-reporter": "^2.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
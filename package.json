{
  "name": "bookstore-demo",
  "version": "1.0.0",
  "description": "A simple book selling app with Paystack integration",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:manual": "echo 'Run manual tests from docs/testing/Manual_Test_Scripts.md'",
    "test:auto": "react-scripts test",
    "test:e2e": "cypress run",
    "test:all": "npm run test:auto && npm run test:e2e",
    "test:coverage": "npm run test:auto -- --coverage --watchAll=false",
    "cy:open": "cypress open",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.22.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^13.17.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
